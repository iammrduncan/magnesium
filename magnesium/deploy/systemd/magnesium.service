# Magnesium server as a systemd user unit (`systemctl --user`), run as the
# account that runs the agents. Never use `t3 service install`: it pins a
# runtime downloaded from the release origin.
#
# Host and port come from ~/.config/magnesium/magnesium.env, for example
#   T3CODE_HOST=<the address the hub reaches this machine on, such as a LAN IP>
#   T3CODE_PORT=3773
# Secrets never go in this unit or that file; they pass by name only.
[Unit]
Description=Magnesium server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=-%h/.config/magnesium/magnesium.env
# State lives apart from any T3 Code install in ~/.t3.
Environment=T3CODE_HOME=%h/.magnesium
Environment=T3CODE_TELEMETRY_ENABLED=false
Environment=T3CODE_NO_BROWSER=true
# Provider CLIs (claude, codex) usually live in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# bin/magnesium-release points current at a built release.
ExecStart=%h/.local/share/magnesium/node/bin/node %h/.local/share/magnesium/current/apps/server/dist/bin.mjs serve
# `serve` prints a fresh pairing token on stdout at every start. Drop stdout so
# no token reaches the journal; the server keeps its own logs under
# $T3CODE_HOME/userdata/logs. Pair a browser with `bin.mjs pair` on demand.
StandardOutput=null
StandardError=journal
Restart=on-failure
RestartSec=5
# Effect's runMain exits 130 when a stop signal interrupts it; that is a clean stop.
SuccessExitStatus=130

[Install]
WantedBy=default.target
