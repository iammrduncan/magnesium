#!/usr/bin/env bash
# Builds, switches and rolls back Magnesium releases on one machine.
#
#   magnesium-release build <git-ref> <source>  clone <source> (a URL, path or bundle) at
#                                               <git-ref> into releases/<sha>, install, build
#   magnesium-release activate <sha>            run releases/<sha>; the old one becomes `previous`
#   magnesium-release rollback                  run `previous` again (one command back)
#   magnesium-release status                    show current, previous and every release
#   magnesium-release pack <sha> <file.tar.gz>  pack built releases/<sha> for a host that
#                                               doesn't build (the server and its runtime
#                                               dependencies only, about 300 MB)
#   magnesium-release unpack <file.tar.gz>      unpack a packed release into releases/<sha>
#
# Layout under $MAGNESIUM_ROOT (default ~/.local/share/magnesium):
#   node/              Node 24
#   releases/<sha>/    a built checkout, or an unpacked pack
#   current, previous  symlinks into releases/
# systemd/magnesium.service runs current/apps/server/dist/bin.mjs. Activating
# seeds $MAGNESIUM_HOME/userdata/settings.json from the release when it is
# missing, then restarts the unit if it is installed (MAGNESIUM_RESTART=0 skips).
# MAGNESIUM_PNPM and MAGNESIUM_VP replace the install and build commands.
set -euo pipefail

ROOT="${MAGNESIUM_ROOT:-$HOME/.local/share/magnesium}"
STATE_HOME="${MAGNESIUM_HOME:-$HOME/.magnesium}"
UNIT="magnesium.service"
read -r -a PNPM <<< "${MAGNESIUM_PNPM:-corepack pnpm}"
read -r -a VP <<< "${MAGNESIUM_VP:-vp}"

die() {
  echo "magnesium-release: $*" >&2
  exit 1
}

# Runs a command with this machine's Node 24 first on PATH.
with_node() {
  PATH="$ROOT/node/bin:$PATH" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$@"
}

is_built() {
  [ -f "$1/apps/server/dist/bin.mjs" ]
}

restart_unit() {
  if [ "${MAGNESIUM_RESTART:-1}" = "0" ]; then
    return
  fi
  if command -v systemctl > /dev/null && systemctl --user cat "$UNIT" > /dev/null 2>&1; then
    systemctl --user restart "$UNIT"
    echo "Restarted $UNIT."
  else
    echo "$UNIT is not installed; restart the server yourself."
  fi
}

seed_settings() {
  local release="$1"
  local settings="$STATE_HOME/userdata/settings.json"
  local seed="$release/magnesium/deploy/seed/settings.json"
  if [ ! -f "$settings" ] && [ -f "$seed" ]; then
    mkdir -p "$STATE_HOME/userdata"
    cp "$seed" "$settings"
    echo "Seeded $settings."
  fi
}

switch_to() {
  local name="$1"
  local target="releases/$name"
  is_built "$ROOT/$target" || die "release $name is missing or not built"
  local old
  old="$(readlink "$ROOT/current" 2> /dev/null || true)"
  if [ "$old" = "$target" ]; then
    echo "$name is already current."
    return
  fi
  ln -sfn "$target" "$ROOT/current"
  if [ -n "$old" ]; then
    ln -sfn "$old" "$ROOT/previous"
  fi
  echo "current -> $name${old:+ (previous -> ${old#releases/})}"
  seed_settings "$ROOT/$target"
  restart_unit
}

build() {
  local ref="$1" source="$2"
  mkdir -p "$ROOT/releases"
  local work="$ROOT/releases/.build-$$"
  rm -rf "$work"
  git clone --quiet "$source" "$work"
  # A clone of a bundle or bare repo may have no local branches, so resolve the
  # ref to a commit, trying the remote's branch too.
  local commit
  commit="$(git -C "$work" rev-parse --verify --quiet "$ref^{commit}" ||
    git -C "$work" rev-parse --verify --quiet "origin/$ref^{commit}")" ||
    die "unknown ref $ref in $source"
  git -C "$work" checkout --quiet --detach "$commit"
  local sha
  sha="$(git -C "$work" rev-parse --short=10 HEAD)"
  local dest="$ROOT/releases/$sha"
  if is_built "$dest"; then
    rm -rf "$work"
    echo "$sha is already built."
    return
  fi
  # A folder without a server is another build still running, or one that
  # failed. Never delete it from under a running build.
  if [ -e "$dest" ]; then
    rm -rf "$work"
    die "releases/$sha exists but is not built: another build is running, or one failed (remove it to retry)"
  fi
  mv "$work" "$dest"
  (
    cd "$dest"
    with_node "${PNPM[@]}" install --frozen-lockfile
    PATH="$dest/node_modules/.bin:$ROOT/node/bin:$PATH" "${VP[@]}" run --filter t3 build
  )
  is_built "$dest" || die "the build of $sha produced no server"
  echo "Built $sha. Run: magnesium-release activate $sha"
}

pack() {
  local name="$1" out="$2"
  local release="$ROOT/releases/$name"
  is_built "$release" || die "release $name is missing or not built"
  local work
  work="$(mktemp -d)"
  # The published `t3` package's shape: dist plus its production dependencies.
  (cd "$release" && with_node "${PNPM[@]}" --filter t3 deploy --prod --legacy "$work/apps/server" > /dev/null)
  mkdir -p "$work/magnesium/deploy/seed"
  cp "$release/magnesium/deploy/seed/settings.json" "$work/magnesium/deploy/seed/settings.json"
  echo "$name" > "$work/RELEASE"
  is_built "$work" || { rm -rf "$work"; die "the pack of $name has no server"; }
  tar -czf "$out" -C "$work" .
  rm -rf "$work"
  echo "Packed $name into $out."
}

unpack() {
  local file="$1"
  mkdir -p "$ROOT/releases"
  local work="$ROOT/releases/.unpack-$$"
  rm -rf "$work"
  mkdir -p "$work"
  tar -xzf "$file" -C "$work"
  local name
  name="$(cat "$work/RELEASE" 2> /dev/null || true)"
  [[ "$name" =~ ^[0-9a-f]{7,40}$ ]] || { rm -rf "$work"; die "$file is not a packed release"; }
  is_built "$work" || { rm -rf "$work"; die "$file has no server"; }
  if is_built "$ROOT/releases/$name"; then
    rm -rf "$work"
    echo "$name is already unpacked."
    return
  fi
  if [ -e "$ROOT/releases/$name" ]; then
    rm -rf "$work"
    die "releases/$name exists but is not built: another build or unpack is running, or one failed (remove it to retry)"
  fi
  mv "$work" "$ROOT/releases/$name"
  echo "Unpacked $name. Run: magnesium-release activate $name"
}

status() {
  echo "current:  $(readlink "$ROOT/current" 2> /dev/null || echo none)"
  echo "previous: $(readlink "$ROOT/previous" 2> /dev/null || echo none)"
  if [ -d "$ROOT/releases" ]; then
    for release in "$ROOT"/releases/*/; do
      [ -d "$release" ] || continue
      local name
      name="$(basename "$release")"
      if is_built "$release"; then echo "  $name"; else echo "  $name (not built)"; fi
    done
  fi
}

case "${1:-}" in
  build)
    [ $# -eq 3 ] || die "usage: magnesium-release build <git-ref> <source>"
    build "$2" "$3"
    ;;
  activate)
    [ $# -eq 2 ] || die "usage: magnesium-release activate <sha>"
    switch_to "$2"
    ;;
  rollback)
    previous="$(readlink "$ROOT/previous" 2> /dev/null || true)"
    [ -n "$previous" ] || die "there is no previous release"
    switch_to "${previous#releases/}"
    ;;
  status)
    status
    ;;
  pack)
    [ $# -eq 3 ] || die "usage: magnesium-release pack <sha> <file.tar.gz>"
    pack "$2" "$3"
    ;;
  unpack)
    [ $# -eq 2 ] || die "usage: magnesium-release unpack <file.tar.gz>"
    unpack "$2"
    ;;
  *)
    die "usage: magnesium-release build|activate|rollback|status|pack|unpack"
    ;;
esac
