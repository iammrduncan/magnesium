#!/usr/bin/env bash
# Builds, switches and rolls back Magnesium releases on one machine.
#
#   magnesium-release build <git-ref> <source>  clone <source> (a URL, path or bundle) at
#                                               <git-ref> into releases/<sha>, install, build
#   magnesium-release activate <sha>            run releases/<sha>; the old one becomes `previous`
#   magnesium-release rollback                  run `previous` again (one command back)
#   magnesium-release status                    show current, previous and every release
#   magnesium-release pack <sha> <file.tar.gz>  pack built releases/<sha> for a host that
#                                               doesn't build (the server and its runtime
#                                               dependencies only, about 300 MB)
#   magnesium-release unpack <file.tar.gz>      unpack a packed release into releases/<sha>
#   magnesium-release prune                     remove built releases beyond the newest
#                                               $MAGNESIUM_RELEASE_KEEP (default 2), never
#                                               current or previous
#   magnesium-release backup                    copy the state folder into backups/<UTC time>
#   magnesium-release restore <backup>          stop the server, put a backup back, start it
#   magnesium-release apply-pending             before the server starts: run the update,
#                                               rollback or restore it left in upkeep/pending,
#                                               and switch back from a new release that keeps
#                                               failing to start (its launcher runs this)
#   magnesium-release pair [--admin]            print a one-time pairing code, link and QR code
#                                               (15 minutes) for a device; --admin lets that
#                                               device pair others from Settings → Connections.
#                                               The link uses $MAGNESIUM_HOME/public-url when the
#                                               hub role wrote one.
#
# Layout under $MAGNESIUM_ROOT (default ~/.local/share/magnesium):
#   node/              Node 24
#   releases/<sha>/    a built checkout, or an unpacked pack
#   current, previous  symlinks into releases/
# systemd/magnesium.service runs current/apps/server/dist/bin.mjs. Activating
# backs up the state, seeds $MAGNESIUM_HOME/userdata/settings.json from the
# release when it is missing, then restarts the unit if it is installed
# (MAGNESIUM_RESTART=0 skips). MAGNESIUM_PNPM and MAGNESIUM_VP replace the
# install and build commands.
#
# Backups live in $MAGNESIUM_HOME/backups. The newest of each of the last
# $MAGNESIUM_BACKUP_KEEP days (default 7) that have one is kept, and the three
# newest whatever their day. A restore first backs up the state it replaces.
#
# activate, rollback and restore stop or restart the unit, which ends every
# process in it, a Fleet terminal's shell included. Started there, they go on
# as a transient unit of their own and say how to follow it.
#
# The server's own Update, Roll back and Restore (Fleet, goal 35) write one line
# to $MAGNESIUM_HOME/upkeep/pending and stop the server; its launcher (the unit's
# ExecStartPre, or a pod's entrypoint) runs apply-pending while it is stopped.
# A release switched to that way is on trial: the server ends the trial once it
# has run a while, and the third start without that switches back. Each outcome
# is written to upkeep/result.json for Fleet.
set -euo pipefail

ROOT="${MAGNESIUM_ROOT:-$HOME/.local/share/magnesium}"
STATE_HOME="${MAGNESIUM_HOME:-$HOME/.magnesium}"
UNIT="magnesium.service"
BACKUP_NAME='^[0-9]{8}T[0-9]{6}Z(-[0-9]+)?$'
PRUNE=1
read -r -a PNPM <<< "${MAGNESIUM_PNPM:-corepack pnpm}"
read -r -a VP <<< "${MAGNESIUM_VP:-vp}"

# A consistent copy of a live SQLite database, through Node's own SQLite.
SQLITE_BACKUP='
const { DatabaseSync, backup } = require("node:sqlite");
const [source, target] = process.argv.slice(1);
const db = new DatabaseSync(source);
backup(db, target).finally(() => db.close());
'

die() {
  echo "magnesium-release: $*" >&2
  exit 1
}

# Runs a command with this machine's Node 24 first on PATH.
with_node() {
  PATH="$ROOT/node/bin:$PATH" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$@"
}

is_built() {
  [ -f "$1/apps/server/dist/bin.mjs" ]
}

# Runs `systemctl --user <restart|stop|start>` on the unit when it is installed.
unit_ctl() {
  if [ "${MAGNESIUM_RESTART:-1}" = "0" ]; then
    return
  fi
  if command -v systemctl > /dev/null && systemctl --user cat "$UNIT" > /dev/null 2>&1; then
    systemctl --user "$1" "$UNIT"
    case "$1" in
      restart) echo "Restarted $UNIT." ;;
      stop) echo "Stopped $UNIT." ;;
      start) echo "Started $UNIT." ;;
    esac
  else
    echo "$UNIT is not installed; $1 the server yourself."
  fi
}

# Re-runs this command as its own transient unit when it runs inside the
# server's unit, which stopping the server would end halfway.
outlive_unit() {
  [ "${MAGNESIUM_RESTART:-1}" != "0" ] && [ -z "${MAGNESIUM_OUTSIDE_UNIT:-}" ] || return 0
  grep -qs "/$UNIT\$" "${MAGNESIUM_CGROUP_FILE:-/proc/self/cgroup}" || return 0
  local name self
  name="magnesium-$1-$(date -u +%Y%m%dT%H%M%SZ)"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  local env=(--setenv=MAGNESIUM_OUTSIDE_UNIT=1 "--setenv=MAGNESIUM_ROOT=$ROOT" "--setenv=MAGNESIUM_HOME=$STATE_HOME")
  local var
  for var in PATH MAGNESIUM_BACKUP_KEEP MAGNESIUM_RELEASE_KEEP MAGNESIUM_PNPM MAGNESIUM_VP; do
    if [ -n "${!var:-}" ]; then env+=("--setenv=$var=${!var}"); fi
  done
  # Said first: once the server stops, this shell may be gone.
  echo "This shell runs inside $UNIT, which $1 stops, so it goes on as $name."
  echo "Follow it with: journalctl --user -u $name -f"
  systemd-run --user --collect --quiet --unit "$name" "${env[@]}" "$self" "$@" ||
    die "could not start $name; run this from a shell outside $UNIT"
  exit 0
}

seed_settings() {
  local release="$1"
  local settings="$STATE_HOME/userdata/settings.json"
  local seed="$release/magnesium/deploy/seed/settings.json"
  if [ ! -f "$settings" ] && [ -f "$seed" ]; then
    mkdir -p "$STATE_HOME/userdata"
    cp "$seed" "$settings"
    echo "Seeded $settings."
  fi
}

switch_to() {
  local name="$1"
  local target="releases/$name"
  is_built "$ROOT/$target" || die "release $name is missing or not built"
  local old
  old="$(readlink "$ROOT/current" 2> /dev/null || true)"
  if [ "$old" = "$target" ]; then
    echo "$name is already current."
    return
  fi
  # A new release may migrate the database; keep a copy from before it does.
  backup
  ln -sfn "$target" "$ROOT/current"
  if [ -n "$old" ]; then
    ln -sfn "$old" "$ROOT/previous"
  fi
  echo "current -> $name${old:+ (previous -> ${old#releases/})}"
  seed_settings "$ROOT/$target"
  unit_ctl restart
}

backup() {
  local userdata="$STATE_HOME/userdata"
  if [ ! -d "$userdata" ]; then
    echo "No state to back up yet."
    return
  fi
  local backups="$STATE_HOME/backups"
  mkdir -p "$backups"
  chmod 700 "$backups"
  local name
  name="$(date -u +%Y%m%dT%H%M%SZ)"
  if [ -e "$backups/$name" ]; then
    name="$name-$$"
  fi
  # Fill a scratch folder first, so a half-done backup never looks like a good one.
  local work="$backups/.partial-$$"
  rm -rf "$work"
  mkdir -p "$work"
  local entry base
  shopt -s nullglob
  for entry in "$userdata"/*; do
    base="$(basename "$entry")"
    case "$base" in
      # server-owner.sqlite is the running server's lock: an exclusive transaction, no data.
      logs | server-runtime.json | server-owner.sqlite | *.sqlite-wal | *.sqlite-shm | *.sqlite-journal) ;;
      *.sqlite) with_node node --no-warnings -e "$SQLITE_BACKUP" "$entry" "$work/$base" ;;
      *) cp -a "$entry" "$work/" ;;
    esac
  done
  shopt -u nullglob
  mv "$work" "$backups/$name"
  echo "Backed up the state to backups/$name."
  if [ "$PRUNE" = "1" ]; then
    prune_backups
  fi
}

# Keeps the newest backup of each of the last $MAGNESIUM_BACKUP_KEEP days that
# have one, and the three newest whatever their day. Every change backs up
# first, so a busy day must not push out the days before it. Names sort by
# time, and start with their UTC day.
prune_backups() {
  local keep="${MAGNESIUM_BACKUP_KEEP:-7}" recent=3
  local all=() dir name
  for dir in "$STATE_HOME"/backups/*/; do
    name="$(basename "$dir")"
    if [[ "$name" =~ $BACKUP_NAME ]]; then
      all+=("$name")
    fi
  done
  local i newest day last_day="" days=0
  for ((i = ${#all[@]} - 1; i >= 0; i--)); do
    name="${all[$i]}"
    newest=$((${#all[@]} - 1 - i))
    day="${name:0:8}"
    if [ "$day" != "$last_day" ]; then
      last_day="$day"
      days=$((days + 1))
      [ "$days" -le "$keep" ] && continue
    fi
    [ "$newest" -lt "$recent" ] && continue
    rm -rf "${STATE_HOME:?}/backups/${name}"
  done
}

# Removes built releases beyond the newest $MAGNESIUM_RELEASE_KEEP, besides current
# and previous. A folder still being built or unpacked is never touched: it is
# hidden (.build-*, .unpack-*) or not built yet.
prune_releases() {
  local keep="${MAGNESIUM_RELEASE_KEEP:-2}"
  [[ "$keep" =~ ^[0-9]+$ ]] || die "MAGNESIUM_RELEASE_KEEP must be a number"
  local current previous
  current="$(readlink "$ROOT/current" 2> /dev/null || true)"
  previous="$(readlink "$ROOT/previous" 2> /dev/null || true)"
  local kept=0 removed=0 dir name
  # Newest first.
  while IFS= read -r dir; do
    dir="${dir%/}"
    name="$(basename "$dir")"
    is_built "$dir" || continue
    if [ "releases/$name" = "$current" ] || [ "releases/$name" = "$previous" ]; then
      continue
    fi
    if [ "$kept" -lt "$keep" ]; then
      kept=$((kept + 1))
      continue
    fi
    rm -rf "${ROOT:?}/releases/$name"
    echo "Removed old release $name."
    removed=$((removed + 1))
  done < <(ls -1td "$ROOT"/releases/*/ 2> /dev/null || true)
  echo "Removed $removed old release(s)."
}

restore() {
  local name="$1"
  local from="$STATE_HOME/backups/$name"
  [[ "$name" =~ $BACKUP_NAME ]] && [ -d "$from" ] || die "no backup named $name in $STATE_HOME/backups"
  outlive_unit restore "$name"
  local userdata="$STATE_HOME/userdata"
  unit_ctl stop
  # Keep the state being replaced, so a restore can be undone. Don't prune:
  # the backup being restored may be the oldest one.
  PRUNE=0 backup
  mkdir -p "$userdata"
  local entry base
  shopt -s nullglob
  for entry in "$from"/*.sqlite; do
    base="$(basename "$entry")"
    rm -f "$userdata/$base" "$userdata/$base-wal" "$userdata/$base-shm" "$userdata/$base-journal"
  done
  shopt -u nullglob
  cp -a "$from"/. "$userdata"/
  echo "Restored backups/$name."
  unit_ctl start
}

# Waits while another process on this host holds a build lock: until it lets
# go, its process is gone (a stale lock, removed), or MAGNESIUM_BUILD_WAIT
# seconds (an hour) pass.
wait_for_build() {
  local lock="$1" waited=0 limit="${MAGNESIUM_BUILD_WAIT:-3600}" poll="${MAGNESIUM_BUILD_POLL:-5}" pid
  echo "Another build of this commit is running here; waiting for it."
  while [ -d "$lock" ]; do
    pid="$(cat "$lock/pid" 2> /dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2> /dev/null; then
      rm -rf "$lock"
      break
    fi
    [ "$waited" -lt "$limit" ] || die "timed out waiting for another build of this commit"
    sleep "$poll"
    waited=$((waited + poll))
  done
}

build() {
  local ref="$1" source="$2"
  # A pinned commit that is already built needs no clone.
  if [[ "$ref" =~ ^[0-9a-f]{10,40}$ ]] && is_built "$ROOT/releases/${ref:0:10}"; then
    echo "${ref:0:10} is already built."
    return
  fi
  mkdir -p "$ROOT/releases"
  local work="$ROOT/releases/.build-$$"
  rm -rf "$work"
  # A bundle has no HEAD, so clone falls back to the default branch name and
  # prints a hint about it unless one is set.
  git -c init.defaultBranch=main clone --quiet "$source" "$work"
  # A clone of a bundle or bare repo may have no local branches, so resolve the
  # ref to a commit, trying the remote's branch too.
  local commit
  commit="$(git -C "$work" rev-parse --verify --quiet "$ref^{commit}" ||
    git -C "$work" rev-parse --verify --quiet "origin/$ref^{commit}")" ||
    die "unknown ref $ref in $source"
  git -C "$work" checkout --quiet --detach "$commit"
  local sha
  sha="$(git -C "$work" rev-parse --short=10 HEAD)"
  local dest="$ROOT/releases/$sha"
  if is_built "$dest"; then
    rm -rf "$work"
    echo "$sha is already built."
    return
  fi
  # Two deploys can share a build host (a hub that doesn't build, and the host
  # itself). The first to take this lock builds; another waits and uses it.
  local lock="$ROOT/releases/.lock-$sha"
  while ! mkdir "$lock" 2> /dev/null; do
    wait_for_build "$lock"
    if is_built "$dest"; then
      rm -rf "$work"
      echo "$sha is already built."
      return
    fi
  done
  echo "$$" > "$lock/pid"
  BUILD_LOCK="$lock"
  trap 'rm -rf "$BUILD_LOCK"' EXIT
  # A folder without a server is a build that failed, or one from a release
  # script without the lock still running. Never delete it from under it.
  if [ -e "$dest" ]; then
    rm -rf "$work"
    die "releases/$sha exists but is not built: another build is running, or one failed (remove it to retry)"
  fi
  mv "$work" "$dest"
  (
    cd "$dest"
    with_node "${PNPM[@]}" install --frozen-lockfile
    PATH="$dest/node_modules/.bin:$ROOT/node/bin:$PATH" "${VP[@]}" run --filter t3 build
  )
  is_built "$dest" || die "the build of $sha produced no server"
  echo "Built $sha. Run: magnesium-release activate $sha"
}

pack() {
  local name="$1" out="$2"
  local release="$ROOT/releases/$name"
  is_built "$release" || die "release $name is missing or not built"
  # An unpacked pack is in the packed shape already: send it on as it is.
  if [ -f "$release/RELEASE" ]; then
    tar -czf "$out" -C "$release" .
    echo "Packed $name into $out."
    return
  fi
  local work
  work="$(mktemp -d)"
  # The published `t3` package's shape: dist plus its production dependencies.
  (cd "$release" && with_node "${PNPM[@]}" --filter t3 deploy --prod --legacy "$work/apps/server" > /dev/null)
  mkdir -p "$work/magnesium/deploy/seed" "$work/magnesium/deploy/bin"
  cp "$release/magnesium/deploy/seed/settings.json" "$work/magnesium/deploy/seed/settings.json"
  # The agent wrappers, the fence and magnesium-agents run beside the server.
  cp -a "$release/magnesium/deploy/bin/." "$work/magnesium/deploy/bin/"
  echo "$name" > "$work/RELEASE"
  is_built "$work" || { rm -rf "$work"; die "the pack of $name has no server"; }
  tar -czf "$out" -C "$work" .
  rm -rf "$work"
  echo "Packed $name into $out."
}

unpack() {
  local file="$1"
  mkdir -p "$ROOT/releases"
  local work="$ROOT/releases/.unpack-$$"
  rm -rf "$work"
  mkdir -p "$work"
  tar -xzf "$file" -C "$work"
  local name
  name="$(cat "$work/RELEASE" 2> /dev/null || true)"
  [[ "$name" =~ ^[0-9a-f]{7,40}$ ]] || { rm -rf "$work"; die "$file is not a packed release"; }
  is_built "$work" || { rm -rf "$work"; die "$file has no server"; }
  if is_built "$ROOT/releases/$name"; then
    rm -rf "$work"
    echo "$name is already unpacked."
    return
  fi
  if [ -e "$ROOT/releases/$name" ]; then
    rm -rf "$work"
    die "releases/$name exists but is not built: another build or unpack is running, or one failed (remove it to retry)"
  fi
  mv "$work" "$ROOT/releases/$name"
  echo "Unpacked $name. Run: magnesium-release activate $name"
}

pair() {
  is_built "$ROOT/current" || die "no current release"
  local args=(pair --ttl 15m)
  case "${1:-}" in
    --admin) args+=(--admin --label "admin device") ;;
    "") ;;
    *) die "usage: magnesium-release pair [--admin]" ;;
  esac
  if [ -s "$STATE_HOME/public-url" ]; then
    args+=(--base-url "$(head -n 1 "$STATE_HOME/public-url")")
  fi
  T3CODE_HOME="$STATE_HOME" with_node node "$ROOT/current/apps/server/dist/bin.mjs" "${args[@]}"
}

status() {
  echo "current:  $(readlink "$ROOT/current" 2> /dev/null || echo none)"
  echo "previous: $(readlink "$ROOT/previous" 2> /dev/null || echo none)"
  if [ -d "$ROOT/releases" ]; then
    for release in "$ROOT"/releases/*/; do
      [ -d "$release" ] || continue
      local name
      name="$(basename "$release")"
      if is_built "$release"; then echo "  $name"; else echo "  $name (not built)"; fi
    done
  fi
}

# How many starts a release switched to by apply-pending gets before it is
# switched back. The server ends the trial once it has run a while.
TRIAL_STARTS=3

# Writes upkeep/result.json: kind, from, to, ok, detail. Names and builds are
# plain [0-9A-Za-z._-], so they need no escaping; the detail is escaped.
write_result() {
  local kind="$1" from="$2" to="$3" ok="$4" detail="$5"
  detail="${detail//\\/\\\\}"
  detail="${detail//\"/\\\"}"
  mkdir -p "$STATE_HOME/upkeep"
  printf '{"kind":"%s","from":"%s","to":"%s","ok":%s,"detail":"%s","at":"%s"}\n' \
    "$kind" "$from" "$to" "$ok" "$detail" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > "$STATE_HOME/upkeep/result.json.new"
  mv "$STATE_HOME/upkeep/result.json.new" "$STATE_HOME/upkeep/result.json"
}

current_name() {
  local link
  link="$(readlink "$ROOT/current" 2> /dev/null || true)"
  echo "${link#releases/}"
}

previous_name() {
  local link
  link="$(readlink "$ROOT/previous" 2> /dev/null || true)"
  echo "${link#releases/}"
}

# activate <sha> <update|rollback>: switch while the server is stopped, on trial.
pending_activate() {
  local name="$1" kind="$2" old before
  old="$(current_name)"
  before="$(previous_name)"
  # Said first, so a switch that dies halfway still leaves an answer.
  write_result "$kind" "$old" "$name" false "$name couldn't be switched to."
  if ! is_built "$ROOT/releases/$name"; then
    write_result "$kind" "$old" "$name" false "$name isn't on this machine."
    return
  fi
  MAGNESIUM_RESTART=0 switch_to "$name"
  # The build before the switch, "-" for none: the one to keep as previous if it goes back.
  printf '%s %s %s 0 %s\n' "$kind" "$old" "$name" "${before:--}" > "$STATE_HOME/upkeep/trial"
  write_result "$kind" "$old" "$name" true "Starting on $name."
}

# restore <backup>: put a backup back while the server is stopped.
pending_restore() {
  local name="$1"
  write_result restore "" "$name" false "The restore of $name didn't finish."
  if ! [[ "$name" =~ $BACKUP_NAME ]] || ! [ -d "$STATE_HOME/backups/$name" ]; then
    write_result restore "" "$name" false "There is no backup named $name."
    return
  fi
  MAGNESIUM_RESTART=0 restore "$name"
  write_result restore "" "$name" true "Restored $name; the state it replaced is a backup of its own."
}

# Counts a start of a release on trial; the last one allowed switches back.
check_trial() {
  local trial="$STATE_HOME/upkeep/trial" kind from to starts before
  read -r kind from to starts before < "$trial" || { rm -f "$trial"; return; }
  if [ "$(current_name)" != "$to" ]; then
    rm -f "$trial"
    return
  fi
  starts=$((starts + 1))
  if [ "$starts" -lt "$TRIAL_STARTS" ] || [ -z "$from" ]; then
    printf '%s %s %s %s %s\n' "$kind" "$from" "$to" "$starts" "$before" > "$trial"
    return
  fi
  rm -f "$trial"
  MAGNESIUM_RESTART=0 switch_to "$from"
  # A build that never started is no build to go back to: previous is what it was before.
  case "$before" in
    "") ;; # A trial written before this was recorded.
    -) rm -f "$ROOT/previous" ;;
    *) ln -sfn "releases/$before" "$ROOT/previous" ;;
  esac
  write_result "$kind" "$from" "$to" false "$to stopped $TRIAL_STARTS times while starting, so this server is back on $from."
}

apply_pending() {
  local dir="$STATE_HOME/upkeep"
  [ -d "$dir" ] || return 0
  if [ -f "$dir/pending" ]; then
    local op arg kind
    read -r op arg kind < "$dir/pending" || true
    # Taken first: an operation that fails is never tried again on every start.
    rm -f "$dir/pending"
    case "$op" in
      activate) pending_activate "$arg" "${kind:-update}" ;;
      restore) pending_restore "$arg" ;;
      *) echo "magnesium-release: ignored an unknown pending operation: $op" >&2 ;;
    esac
  elif [ -f "$dir/trial" ]; then
    check_trial
  fi
}

case "${1:-}" in
  build)
    [ $# -eq 3 ] || die "usage: magnesium-release build <git-ref> <source>"
    build "$2" "$3"
    ;;
  activate)
    [ $# -eq 2 ] || die "usage: magnesium-release activate <sha>"
    outlive_unit "$@"
    switch_to "$2"
    ;;
  rollback)
    previous="$(readlink "$ROOT/previous" 2> /dev/null || true)"
    [ -n "$previous" ] || die "there is no previous release"
    outlive_unit "$@"
    switch_to "${previous#releases/}"
    ;;
  status)
    status
    ;;
  pack)
    [ $# -eq 3 ] || die "usage: magnesium-release pack <sha> <file.tar.gz>"
    pack "$2" "$3"
    ;;
  unpack)
    [ $# -eq 2 ] || die "usage: magnesium-release unpack <file.tar.gz>"
    unpack "$2"
    ;;
  prune)
    [ $# -eq 1 ] || die "usage: magnesium-release prune"
    prune_releases
    ;;
  backup)
    [ $# -eq 1 ] || die "usage: magnesium-release backup"
    backup
    ;;
  restore)
    [ $# -eq 2 ] || die "usage: magnesium-release restore <backup>"
    restore "$2"
    ;;
  apply-pending)
    [ $# -eq 1 ] || die "usage: magnesium-release apply-pending"
    apply_pending
    ;;
  pair)
    [ $# -le 2 ] || die "usage: magnesium-release pair [--admin]"
    pair "${2:-}"
    ;;
  *)
    die "usage: magnesium-release build|activate|rollback|status|pack|unpack|prune|backup|restore|apply-pending|pair"
    ;;
esac
