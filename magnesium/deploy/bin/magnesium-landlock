#!/usr/bin/env python3
"""magnesium-landlock [--hide DIR]... [--protect PATH]... [--ro PATH]... [--rw PATH]... -- COMMAND [ARGS...]

Runs COMMAND with every path readable and writable as usual, except:
  --hide DIR      it can neither read nor write DIR (Magnesium's state home)
  --protect PATH  it can read PATH but never change it (Magnesium's install and config)
Paths inside those come back with --ro (read-only) or --rw (read-write).

Uses Linux Landlock, so it needs no root, no user namespace and nothing
installed beyond Python 3. The rules hold across exec and for every child, and
Landlock also keeps the command from tracing or reading /proc of processes
outside the fence, such as the Magnesium server.

`magnesium-landlock --probe` prints the kernel's Landlock ABI version, or exits 1.

Landlock only grants, so "everything but these" is built by granting each
sibling along the way from / down to each hidden or protected path. Files
directly in those parent folders (such as ~/.gitconfig) can be read and changed
in place, but nothing new can be created directly in them, and they can't be
listed.
"""
import ctypes
import os
import struct
import sys

SYS_CREATE_RULESET, SYS_ADD_RULE, SYS_RESTRICT_SELF = 444, 445, 446  # same on every arch
CREATE_RULESET_VERSION = 1
RULE_PATH_BENEATH = 1
PR_SET_NO_NEW_PRIVS = 38

EXECUTE, WRITE_FILE, READ_FILE, READ_DIR = 1 << 0, 1 << 1, 1 << 2, 1 << 3
DIR_ONLY = sum(1 << bit for bit in range(4, 13))  # remove and make, all kinds
REFER, TRUNCATE, IOCTL_DEV = 1 << 13, 1 << 14, 1 << 15
READ = EXECUTE | READ_FILE | READ_DIR


class RulesetAttr(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_uint64)]


libc = ctypes.CDLL(None, use_errno=True)
libc.syscall.restype = ctypes.c_long


def fail(message):
    sys.stderr.write(f"magnesium-landlock: {message}\n")
    sys.exit(78)


def abi_version():
    return libc.syscall(SYS_CREATE_RULESET, None, ctypes.c_size_t(0), ctypes.c_uint32(CREATE_RULESET_VERSION))


def parse(argv):
    special, readonly, readwrite = {}, [], []
    args = list(argv)
    while args and args[0] != "--":
        flag = args.pop(0)
        if not args:
            fail(f"{flag} needs a path")
        value = os.path.realpath(args.pop(0))
        if flag == "--hide":
            special[value] = "hide"
        elif flag == "--protect":
            special.setdefault(value, "protect")
        elif flag == "--ro":
            readonly.append(value)
        elif flag == "--rw":
            readwrite.append(value)
        else:
            fail(f"unknown option {flag}")
    if len(args) < 2:
        fail("usage: magnesium-landlock [--hide DIR]... [--protect PATH]... [--ro PATH]... [--rw PATH]... -- COMMAND [ARGS...]")
    return special, readonly, readwrite, args[1:]


def main():
    if sys.argv[1:] == ["--probe"]:
        abi = abi_version()
        if abi < 1:
            sys.exit(1)
        print(abi)
        return
    special, readonly, readwrite, command = parse(sys.argv[1:])
    abi = abi_version()
    if abi < 1:
        fail("this kernel has no Landlock")
    every = READ | WRITE_FILE | DIR_ONLY
    file_rights = EXECUTE | READ_FILE | WRITE_FILE
    if abi >= 2:
        every |= REFER
    if abi >= 3:
        every |= TRUNCATE
        file_rights |= TRUNCATE
    if abi >= 5:
        every |= IOCTL_DEV
        file_rights |= IOCTL_DEV

    attr = RulesetAttr(every)
    ruleset = libc.syscall(SYS_CREATE_RULESET, ctypes.byref(attr), ctypes.c_size_t(ctypes.sizeof(attr)), ctypes.c_uint32(0))
    if ruleset < 0:
        fail(f"could not create a ruleset: {os.strerror(ctypes.get_errno())}")

    def allow(path, rights):
        try:
            fd = os.open(path, os.O_PATH | os.O_CLOEXEC)
        except OSError:
            return
        try:
            if not os.path.isdir(path):
                rights &= file_rights
            # struct landlock_path_beneath_attr is packed: u64 allowed_access, s32 parent_fd.
            rule = ctypes.create_string_buffer(struct.pack("=Qi", rights, fd), 12)
            if libc.syscall(SYS_ADD_RULE, ctypes.c_int(ruleset), ctypes.c_uint32(RULE_PATH_BENEATH), rule, ctypes.c_uint32(0)) < 0:
                fail(f"could not allow {path}: {os.strerror(ctypes.get_errno())}")
        finally:
            os.close(fd)

    def walk(folder):
        try:
            entries = os.listdir(folder)
        except OSError:
            return
        for entry in entries:
            path = os.path.join(folder, entry)
            mode = special.get(path)
            if mode == "protect":
                allow(path, READ)
            elif mode == "hide":
                continue
            elif any(other.startswith(path + "/") for other in special):
                walk(path)
            else:
                allow(path, every)

    walk("/")
    for path in readonly:
        allow(path, READ)
    for path in readwrite:
        allow(path, every)

    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        fail("could not set no_new_privs")
    if libc.syscall(SYS_RESTRICT_SELF, ctypes.c_int(ruleset), ctypes.c_uint32(0)) < 0:
        fail(f"could not restrict itself: {os.strerror(ctypes.get_errno())}")
    os.close(ruleset)
    try:
        os.execvp(command[0], command)
    except OSError as error:
        fail(f"could not run {command[0]}: {error.strerror}")


main()
