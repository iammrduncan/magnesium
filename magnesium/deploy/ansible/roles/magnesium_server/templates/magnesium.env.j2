# Managed by Ansible (magnesium_server). Bind address and port; no secrets here.
T3CODE_HOST={{ magnesium_bind_host }}
T3CODE_PORT={{ magnesium_port }}
# The name the hub knows this server by; the hub (or a single box) is `hub`.
MAGNESIUM_MACHINE={{ (magnesium_machine_name | default('')) or inventory_hostname }}
# How this server runs, for Fleet: on a host, or in a VM (an image in a pod sets `pod`).
MAGNESIUM_DEPLOY={{ 'vm' if (ansible_virtualization_role | default('')) == 'guest' else 'bare-metal' }}
{% if (magnesium_sandbox_image | default('')) | length > 0 %}
# The container sandbox's base image, pinned by digest; agents run fenced without it.
MAGNESIUM_SANDBOX_IMAGE={{ magnesium_sandbox_image }}
{% endif %}
