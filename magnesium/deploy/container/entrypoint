#!/usr/bin/env bash
# Starts a Magnesium spoke in its image (goal 25): the state in $HOME/.magnesium,
# settings seeded on the first start as `magnesium-release activate` does, and
# OpenCode's config written from the environment when it asks for one.
#
#   MAGNESIUM_OPENCODE_BASE_URL  the LLM gateway OpenCode uses (LiteLLM or another
#                                OpenAI-compatible one) (unset: leave
#                                ~/.config/opencode alone)
#   MAGNESIUM_OPENCODE_MODELS    its models, comma-separated; the first is the default
#   MAGNESIUM_OPENCODE_API_KEY_ENV  the env var holding the key (LITELLM_API_KEY);
#                                the config names it, never holds it (D36)
#   MAGNESIUM_TIMEZONE           the time zone the server keeps, such as
#                                Europe/Berlin, so scheduled tasks run at the
#                                same clock time on every machine (D64)
set -euo pipefail

die() {
  echo "magnesium: $*" >&2
  exit 1
}

release="${MAGNESIUM_ROOT:-/opt/magnesium-portable}/current"
# The Node to run on: the image's, or the bundle's when attached to a workload.
node_bin="${MAGNESIUM_NODE_BIN:-node}"
[ -n "${HOME:-}" ] && [ -d "$HOME" ] && [ -w "$HOME" ] ||
  die "HOME ($HOME) must be a writable folder: mount the spoke's volume there"
export T3CODE_HOME="${T3CODE_HOME:-$HOME/.magnesium}"
# A gateway talks to its cluster's API, whose CA comes with its service account.
sa_ca=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
if [ -z "${NODE_EXTRA_CA_CERTS:-}" ] && [ -r "$sa_ca" ]; then
  export NODE_EXTRA_CA_CERTS="$sa_ca"
fi
# CLIs the user installs or updates in their home come before the image's.
export PATH="$HOME/.local/bin:$PATH"
# Only the server's clock: an attached workload's own processes keep theirs.
if [ -n "${MAGNESIUM_TIMEZONE:-}" ]; then
  export TZ="$MAGNESIUM_TIMEZONE"
fi

mkdir -p "$T3CODE_HOME/userdata"
settings="$T3CODE_HOME/userdata/settings.json"
if [ ! -f "$settings" ]; then
  cp "$release/magnesium/deploy/seed/settings.json" "$settings"
  echo "magnesium: seeded $settings" >&2
fi

if [ -n "${MAGNESIUM_OPENCODE_BASE_URL:-}" ]; then
  [ -n "${MAGNESIUM_OPENCODE_MODELS:-}" ] || die "MAGNESIUM_OPENCODE_MODELS is empty"
  mkdir -p "$HOME/.config/opencode"
  chmod 700 "$HOME/.config/opencode"
  (
    umask 077
    "$node_bin" --no-warnings -e '
      const [baseURL, models, keyEnv] = process.argv.slice(1);
      const names = models.split(",").map((name) => name.trim()).filter(Boolean);
      const config = {
        $schema: "https://opencode.ai/config.json",
        enabled_providers: ["litellm"],
        provider: {
          litellm: {
            npm: "@ai-sdk/openai-compatible",
            name: "LLM gateway",
            options: { baseURL, apiKey: `{env:${keyEnv}}` },
            models: Object.fromEntries(names.map((name) => [name, { name }])),
          },
        },
        model: `litellm/${names[0]}`,
        small_model: `litellm/${names[0]}`,
        autoupdate: false,
        share: "disabled",
      };
      process.stdout.write(JSON.stringify(config, null, 2) + "\n");
    ' "$MAGNESIUM_OPENCODE_BASE_URL" "$MAGNESIUM_OPENCODE_MODELS" \
      "${MAGNESIUM_OPENCODE_API_KEY_ENV:-LITELLM_API_KEY}" > "$HOME/.config/opencode/opencode.json.new"
  )
  mv "$HOME/.config/opencode/opencode.json.new" "$HOME/.config/opencode/opencode.json"
  # Turn OpenCode on in the server's settings, with the first model as the
  # default, as the role's magnesium_settings does on a machine. Only what the
  # settings don't say yet, so a choice made in Settings stays.
  "$node_bin" --no-warnings -e '
    const fs = require("node:fs");
    const [file, models] = process.argv.slice(1);
    let settings;
    try {
      settings = JSON.parse(fs.readFileSync(file, "utf8"));
    } catch {
      console.error(`magnesium: ${file} is not valid JSON; OpenCode left as it is`);
      process.exit(0);
    }
    const before = JSON.stringify(settings);
    const instances = (settings.providerInstances ??= {});
    if (!("opencode" in instances) && settings.providers?.opencode === undefined) {
      instances.opencode = { driver: "opencode", enabled: true };
    }
    const model = models.split(",").map((name) => name.trim()).find(Boolean);
    for (const key of ["defaultModelSelection", "textGenerationModelSelection"]) {
      if (!(key in settings)) settings[key] = { instanceId: "opencode", model: `litellm/${model}` };
    }
    if (JSON.stringify(settings) !== before) {
      fs.writeFileSync(`${file}.new`, JSON.stringify(settings, null, 2) + "\n", { mode: 0o600 });
      fs.renameSync(`${file}.new`, file);
      console.error(`magnesium: OpenCode turned on in ${file}`);
    }
  ' "$settings" "$MAGNESIUM_OPENCODE_MODELS"
fi

cd "$HOME"
# `serve` prints a pairing token at every start; keep it out of the pod's log.
# Pair on demand with `magnesium-release pair`.
exec "$node_bin" "$release/apps/server/dist/bin.mjs" serve > /dev/null
